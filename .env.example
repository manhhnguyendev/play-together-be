NODE_ENV=development
PORT=3000
API_PREFIX=api/v2
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=*

# Database: "pglite" for the embedded zero-install PostgreSQL, "postgres" for a server.
DATABASE_DRIVER=pglite
PGLITE_DIR=.data/pgdata
DATABASE_URL=postgres://postgres:postgres@localhost:5432/playtogether
AUTO_MIGRATE=true
DB_LOGGING=false

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

BCRYPT_ROUNDS=12
THROTTLE_TTL=60
THROTTLE_LIMIT=120

JOBS_ENABLED=true
JOBS_INTERVAL_MS=30000

# Seed credentials for local development only.
SEED_ADMIN_EMAIL=admin@playtogether.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CHARITY_EMAIL=charity@playtogether.local
SEED_CHARITY_PASSWORD=Charity@12345
SEED_DEMO_DATA=true
# Seventy days of finished sessions behind the demo accounts, plus open requests and booked slots,
# so the "Diễn biến phiên" chart, both dashboards, the wallet, the notification feed and the admin
# Orders/Money tables have real data. Skips silently if orders already exist — run
# `npm run db:reset` first, then `npm run db:audit` to re-derive the money graph. Off in tests,
# which seed their own orders.
SEED_DEMO_HISTORY=true

# Integrations. Leave empty to use the safe local adapters.
# OAuth client IDs from the same Google Cloud project. GOOGLE_CLIENT_ID is the "Web
# application" one and is enough on its own; the mobile IDs are only needed when a
# native build asks Google for its own token instead of the web one.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
PUBLIC_BASE_URL=http://localhost:3000

# Outgoing email for OTP delivery. Without SMTP_HOST the API logs codes instead
# of sending them, and (outside production) returns them as `devCode`.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Play Together <no-reply@playtogether.local>
EXPOSE_OTP=true

# Images the app uploads (avatars, gallery photos) land here and are served at /uploads.
# The database keeps the root-relative path, so changing host, port or LAN IP breaks nothing.
# MAX_UPLOAD_MB is the per-image cap; a third-party bucket later replaces the driver, not the URLs.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
